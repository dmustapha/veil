# Veil web app — environment template.
# The hosted app runs on public testnet reads and needs NO secrets to browse.
# These are only for local proof generation and admin scripts.

# Shared secret that gates the /api proving route (any long random string locally).
PROVE_TOKEN_SECRET=your-random-token-here

# Optional: override the Sepolia read RPC (defaults to publicnode).
# NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
